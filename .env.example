# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# =========================================================================
# COMMUNITY PLATFORM MULTI-DB CONFIGURATION (SITE 1 & SITE 2 BRIDGING)
# =========================================================================

# SUPABASE B: Community Database (Storage of posts, comments, reactions, reports, and admins)
COMMUNITY_SUPABASE_URL=
COMMUNITY_SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE A: Authentication & Identity Platform (Validates student JWT tokens from Site 1)
AUTH_SUPABASE_A_URL=
AUTH_SUPABASE_A_ANON_KEY=
# Server only: enables the B admin dashboard to manage exam limits in Supabase A.
# Never expose this value in VITE_* variables or commit the real value.
AUTH_SUPABASE_A_SERVICE_ROLE_KEY=

# COMMUNITY ACCESS & ADMIN SECURITY
COMMUNITY_ALLOWED_ORIGINS=
COMMUNITY_ADMIN_EMAILS=
COMMUNITY_ADMIN_USER_IDS=
ADMIN_RECOVERY_SECRET_KEY=

# OCR & AI ENGINES (Render server-side secrets only; never put these in Site A)
# One OCR.Space key per configured base.
OCR_API_KEY_1=
OCR_API_KEY_2=
OCR_API_KEY_3=
# Optional legacy fallback key; leave empty when using the three keys above.
OCR_API_KEY=
# Shared DeepSeek key, server-side only.
DEEPSEEK_API_KEY=
# The OCR gateway processes only the first three active bases by default.
OCR_BASE_COUNT=3

# APIFY SCRAPER TOKENS (Server-side secrets)
APIFY_TOKEN_1=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=

